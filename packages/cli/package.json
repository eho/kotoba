{
  "name": "@edwinho/kotoba-cli",
  "version": "0.2.0",
  "description": "Kotoba command-line translator backed by @edwinho/kotoba-core and @edwinho/kotoba-gemini.",
  "author": "eho",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/eho/kotoba",
  "repository": {
    "type": "git",
    "url": "https://github.com/eho/kotoba.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/eho/kotoba/issues"
  },
  "keywords": [
    "cli",
    "gemini",
    "language-learning",
    "translation"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kotoba": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/clean-package-dist.ts . && bun build src/index.ts --outdir dist --target bun --format esm --external @edwinho/kotoba-core --external @edwinho/kotoba-gemini && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@edwinho/kotoba-core": "^0.2.0",
    "@edwinho/kotoba-gemini": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
