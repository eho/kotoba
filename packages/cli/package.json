{
  "name": "@edwinho/kotoba-cli",
  "version": "0.1.0",
  "description": "Kotoba command-line translator backed by @edwinho/kotoba-core and @edwinho/kotoba-gemini.",
  "author": "eho",
  "license": "MIT",
  "homepage": "https://github.com/eho/kotoba",
  "repository": {
    "type": "git",
    "url": "https://github.com/eho/kotoba.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/eho/kotoba/issues"
  },
  "keywords": [
    "cli",
    "gemini",
    "language-learning",
    "translation"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "kotoba": "src/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@edwinho/kotoba-core": "workspace:*",
    "@edwinho/kotoba-gemini": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
